{
  "name": "pawpal-viewer",
  "version": "1.4.1",
  "description": "PawPal 桌面宠物查看器（Electron + PixiJS v8）",
  "main": "main.js",
  "author": "QClaw",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:boundary": "electron scripts/boundary-test.cjs",
    "test:mem": "electron scripts/memtest.cjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  },
  "productName": "PawPal",
  "build": {
    "appId": "com.pawpal.desktop",
    "productName": "PawPal",
    "files": [
      "main.js",
      "security-utils.cjs",
      "companion.cjs",
      "stats-store.cjs",
      "status-focus.cjs",
      "guide.html",
      "guide.css",
      "guide.js",
      "guide-preload.cjs",
      "capsule-preload.cjs",
      "capsule.html",
      "capsule.css",
      "capsule.js",
      "focus.cjs",
      "focus-time.cjs",
      "focus-preload.cjs",
      "focus.html",
      "focus.css",
      "focus.js",
      "pet-import.cjs",
      "refs-store.cjs",
      "ark-config.cjs",
      "seedream-client.cjs",
      "seedance-client.cjs",
      "animator.cjs",
      "animator.html",
      "animator-page.js",
      "pet-assembler.cjs",
      "preload.cjs",
      "panel-preload.cjs",
      "panel.html",
      "panel.js",
      "panel.css",
      "refs-preload.cjs",
      "refs.html",
      "refs.css",
      "refs.js",
      "package.json",
      "dist/**/*",
      "index.html",
      "!node_modules/**/*",
      "window-fit.cjs"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PawPal"
    },
    "mac": {
      "icon": "icon_apple_dog.png",
      "category": "public.app-category.entertainment"
    },
    "publish": null
  }
}
